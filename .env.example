# ============================================================
# REQUIRED — no defaults, app will not work without these
# ============================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=api_gateway
DB_USER=postgres
DB_PASSWORD=changeme

# JWT secret string for HS256 should be at least 32 bytes long
JWT_SECRET=change-me-jwt-secret

# ============================================================
# OPTIONAL — defaults shown; set to override
# ============================================================

# Application name passed to the migration runner
APP_NAME=api-gateway

# Set to "production" to serve pre-built static assets from /public
# instead of the dev build path; defaults to development behavior
DENO_ENV=production

# Server port; defaults to 3000
PORT=3000
# SERVER_PORT=3000  # Alternative to PORT (PORT takes precedence)

# Postgres connection pool size; defaults to 10
DB_POOL_SIZE=10

# AES encryption key; defaults to an insecure placeholder — always override in production
ENCRYPTION_SECRET=change-me-encryption-secret

# Set to "false" to skip syncing IPs to the network interface on startup; defaults to true
SYNC_IPS_ON_STARTUP=true

# ============================================================
# INITIAL SUPERADMIN SEED (migration 011_seed_initial_superadmin.ts)
# Required on first start while no SuperAdmin exists; ignored afterwards.
# Remove INITIAL_SUPERADMIN_PASSWORD once the account has been created.
# Password policy: >= 6 chars, lower + upper case, digit, special character.
# ============================================================

INITIAL_SUPERADMIN_USERNAME=superadmin
INITIAL_SUPERADMIN_EMAIL=admin@example.com
INITIAL_SUPERADMIN_PASSWORD=
